# Google Cloud
GCP_PROJECT_ID=your-gcp-project-id
DOCAI_LOCATION=us
DOCAI_PROCESSOR_ID=your-form-parser-processor-id
# Optional: paste the processor Prediction endpoint instead of the three values above
DOCAI_PREDICTION_ENDPOINT=

# Service account JSON path (relative to project root or absolute)
GOOGLE_APPLICATION_CREDENTIALS=./credentials/gcp-service-account.json

# Vertex AI Gemini (vision rescue for messy handwritten/circled pages)
VERTEX_LOCATION=us-central1
GEMINI_MODEL=gemini-2.5-flash
ENABLE_VISION_RESCUE=true

# Pipeline
CHUNK_SIZE=15
MAX_PARALLEL_CHUNKS=4
VISION_MAX_PAGES=40
VISION_DPI=220
DIGITAL_CHAR_THRESHOLD=80
MAX_UPLOAD_MB=500
DATA_DIR=data/jobs

# MongoDB (extraction records; extract still works if this is unreachable)
MONGODB_URI=mongodb://10.103.0.201:27017/
MONGODB_DB=handwritten_extractor
MONGODB_COLLECTION=extractions
MONGODB_ENABLED=true

# false = API only enqueues unprocessed jobs; run: python -m app.worker
INLINE_EXTRACT=false
WORKER_POLL_SECONDS=2
WORKER_MAX_JOBS=2
WORKER_STALE_MINUTES=45
DOCAI_MAX_CONCURRENT=8
GEMINI_MAX_CONCURRENT=4
