# Anthropic (Claude Sonnet 5)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Pipeline
# Visual PDF analysis is reliable at <=100 pages. Extraction JSON is large, so
# we send fewer pages per call (default 20) and also split by file size (32 MB request cap).
CHUNK_PAGES=20
MAX_CHUNK_PAGES=100
MAX_CHUNK_MB=20
MAX_PARALLEL_CHUNKS=2
MAX_OUTPUT_TOKENS=64000
MAX_UPLOAD_MB=500
DATA_DIR=data/jobs
API_PORT=8001

# MongoDB — same schema as the Google extractor, separate collection so workers do not mix jobs
MONGODB_URI=mongodb://10.103.0.201:27017/
MONGODB_DB=handwritten_extractor
MONGODB_COLLECTION=extractions_sonnet
MONGODB_ENABLED=true

# false = API only enqueues unprocessed jobs; run: python -m app.worker
INLINE_EXTRACT=false
WORKER_POLL_SECONDS=2
WORKER_MAX_JOBS=2
WORKER_STALE_MINUTES=45
SONNET_MAX_CONCURRENT=2
ENABLE_SUMMARIZATION=true
SUMMARY_MAX_TOKENS=16000
SUMMARY_CHUNK_CHARS=180000
